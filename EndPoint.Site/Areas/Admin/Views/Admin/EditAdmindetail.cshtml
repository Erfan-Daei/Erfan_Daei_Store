@using Practice_Store.Application.Services.Users.Commands.EditUser_Admin
@using Practice_Store.Application.Services.Users.Queries.GetAdminDetail
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model (GetAdminDetailDto, RequestEditUser_AdminDto)
@{
    ViewData["Title"] = "EditAdmindetail";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section>
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-8 order-lg-1">
                                <form asp-action="EditAdmindetail">
                                <h4 class="mb-3">مشخصات</h4>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="basicInput" class="form-label">نام</label>
                                        <input type="text" class="form-control" id="Name" value="@Model.Item1.Name" placeholder="نام" asp-for="Item2.Name"><span asp-validation-for="Item2.Name"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="lastName" class="form-label">نام خانوادگی</label>
                                            <input type="text" class="form-control" id="LastName" value="@Model.Item1.LastName" placeholder="نام خانوادگی" asp-for="Item2.LastName"><span asp-validation-for="Item2.LastName"></span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="email" class="form-label">پست الکترونیک*</label>
                                        <input type="email" class="form-control" id="Email" value="@Model.Item1.Email" disabled asp-for="Item2.Email"><span asp-validation-for="Item2.Email"></span>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="address" class="form-label">آدرس</label>
                                            <input type="text" class="form-control" id="Address" value="@Model.Item1.Address" placeholder="آدرس" asp-for="Item2.Address"><span asp-validation-for="Item2.Address"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="address" class="form-label">کد پستی</label>
                                            <input type="text" class="form-control" id="PostCode" value="@Model.Item1.PostCode" placeholder="کد پستی" asp-for="Item2.PostCode"><span asp-validation-for="Item2.PostCode"></span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="Mobile" class="form-label">تلفن</label>
                                            <input type="text" class="form-control" id="Mobile" value="@Model.Item1.Mobile" placeholder="تلفن" asp-for="Item2.Mobile"><span asp-validation-for="Item2.Mobile"></span>
                                    </div>
                                </div>
                                <hr class="mb-6">
                                <button type="submit" class="btn btn-primary btn-lg btn-block">ثبت اطلاعات</button>
                            </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <link href="~/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/sweetalert2/sweetalert2.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        function EditAdminDetailFunc(){

                    var Name = $("#Name").val();
                    var LastName = $("#LastName").val();
                    var Mobile = $("#Mobile").val();
                    var Address = $("#Address").val();
                    var PostCode = $("#PostCode").val();
                    var UserId = '@Model.Item1.Id';

                    var postData = {
                        'UserId': UserId,
                        'Name': Name,
                        'LastName': LastName,
                        'PhoneNumber': Mobile,
                        'PostCode': PostCode,
                        'Address': Address,
                    };
                    $.ajax({
                        contentType: 'application/x-www-form-urlencoded',
                        dataType: 'json',
                        type: "PUT",
                        url: "/admin/admin/EditAdmindetail",
                        data: postData,
                        success: function (data) {
                            if (data.isSuccess == true) {
                                window.location.href = '/admin/admin';
                            }
                            else {
                                swal.fire(
                                    'هشدار!',
                                    data.message,
                                    'warning'
                                );
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.responseText);
                        }
                    });
        }
    </script>
}

@section Modals {

}

